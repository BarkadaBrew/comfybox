<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Data-protection keychain access group. Self-signed (no team prefix), so
         the group is the bundle id. Required for kSecUseDataProtectionKeychain
         to work without interactive per-signature ACL prompts. -->
    <key>keychain-access-groups</key>
    <array>
        <string>com.barkadabrew.comfybox.desktop</string>
    </array>
</dict>
</plist>
